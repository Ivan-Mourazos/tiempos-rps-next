DB_SERVER=your-database-host
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_NAME=your-database-name

# Proxy seguro de fotos. Lista separada por comas si cambia infraestructura.
IMAGE_REMOTE_ORIGINS=http://192.168.0.128
IMAGE_REMOTE_PATH_PREFIXES=/SAT/
IMAGE_NETWORK_BASE=\\192.168.0.128\Sisgeko
IMAGE_MAX_BYTES=20971520

# Opcional: estilo MapLibre público consumido polo navegador.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
